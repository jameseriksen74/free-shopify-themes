<div class="section">
  <div class="page-width page-width--form">
    <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'form-stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="RegFirst">{{ 'customer.fields.first_name' | t }}</label>
      <input id="RegFirst" class="field" type="text" name="customer[first_name]" autocomplete="given-name">
      <label for="RegLast">{{ 'customer.fields.last_name' | t }}</label>
      <input id="RegLast" class="field" type="text" name="customer[last_name]" autocomplete="family-name">
      <label for="RegEmail">{{ 'customer.fields.email' | t }}</label>
      <input id="RegEmail" class="field" type="email" name="customer[email]" autocomplete="email" required>
      <label for="RegPassword">{{ 'customer.fields.password' | t }}</label>
      <input id="RegPassword" class="field" type="password" name="customer[password]" autocomplete="new-password" required>
      <button class="button button--full" type="submit">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Customer register", "settings": [] }
{% endschema %}
