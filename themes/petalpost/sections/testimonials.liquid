<div class="section section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <ul class="quotes" role="list">
      {%- for block in section.blocks -%}
        <li class="quote card" {{ block.shopify_attributes }}>
          <blockquote>
            <p class="quote__text">{{ block.settings.quote | escape }}</p>
            {%- if block.settings.author != blank -%}<footer class="quote__author">{{ block.settings.author | escape }}</footer>{%- endif -%}
          </blockquote>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Kind words" } ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "Beautifully packed and even prettier in person." },
      { "type": "text", "id": "author", "label": "Author", "default": "A happy customer" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Testimonials", "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ] }]
}
{% endschema %}
