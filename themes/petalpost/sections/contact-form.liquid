<div class="section section-{{ section.id }}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'form-stack' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="ContactName">{{ 'contact.name' | t }}</label>
      <input id="ContactName" class="field" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      <label for="ContactEmail">{{ 'contact.email' | t }}</label>
      <input id="ContactEmail" class="field" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
      <label for="ContactBody">{{ 'contact.message' | t }}</label>
      <textarea id="ContactBody" class="field" name="contact[body]" rows="6">{{ form.body }}</textarea>
      <button type="submit" class="button">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Say hello" } ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
