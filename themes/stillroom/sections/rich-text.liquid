<div class="section section-{{ section.id }}">
  <div class="page-width rich-text rich-text--{{ section.settings.alignment }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="h1" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link }}" class="button" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "limit": 2, "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share something you love about your shop.</p>" } ] },
    { "type": "button", "name": "Button", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Learn more" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "Rich text", "blocks": [ { "type": "heading" }, { "type": "text" } ] }]
}
{% endschema %}
