{%- assign collection = section.settings.collection -%}
<div class="section section-{{ section.id }}">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if collection != blank and section.settings.show_view_all -%}
        <a href="{{ collection.url }}" class="link-arrow">{{ 'sections.featured_collection.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <li>{% render 'product-card' %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh picks" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
