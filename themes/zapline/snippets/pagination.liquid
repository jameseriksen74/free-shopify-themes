{%- comment -%} Accepts: paginate (required) {%- endcomment -%}
<nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
  <ul role="list">
    {%- if paginate.previous -%}
      <li><a href="{{ paginate.previous.url }}" class="pill" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a></li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="pill">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="pill pill--active" aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span class="pill">{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li><a href="{{ paginate.next.url }}" class="pill" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a></li>
    {%- endif -%}
  </ul>
</nav>
