[
  {
    "name": "theme_info",
    "theme_name": "Zapline",
    "theme_version": "1.0.0",
    "theme_author": "Pretty Things Online",
    "theme_documentation_url": "https://prettythingsonline.com",
    "theme_support_url": "https://prettythingsonline.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0E0E10"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Cards and panels",
        "default": "#1A1A1F"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#F2F2EE"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons)",
        "default": "#D4FF3A"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Accent text",
        "default": "#0E0E10"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary (badges and highlights)",
        "default": "#7B61FF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Sale price",
        "default": "#FF5C39"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "montserrat_n7"
      },
      {
        "type": "range",
        "id": "type_heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 140,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "karla_n4"
      },
      {
        "type": "range",
        "id": "type_body_scale",
        "label": "Body size",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1400
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Image and card corners",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "button_radius",
        "label": "Button corners",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "default": "portrait",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "natural",
            "label": "Natural"
          }
        ]
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note",
        "default": true
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Square image, at least 32 x 32px"
      }
    ]
  },
  {
    "name": "Theme credit",
    "settings": [
      {
        "type": "paragraph",
        "content": "Zapline is a free theme by [Pretty Things Online](https://prettythingsonline.com). Keeping the small footer credit is a lovely way to say thanks."
      },
      {
        "type": "checkbox",
        "id": "show_theme_credit",
        "label": "Show theme credit in footer",
        "default": true
      }
    ]
  }
]