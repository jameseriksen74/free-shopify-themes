{%- paginate customer.addresses by 10 -%}
<div class="section">
  <div class="page-width page-width--narrow">
    <p><a class="link-arrow" href="{{ routes.account_url }}">{{ 'customer.account.title' | t }}</a></p>
    <h1 class="h1">{{ 'customer.addresses.title' | t }}</h1>

    {%- for address in customer.addresses -%}
      <div class="card address">
        {%- if address == customer.default_address -%}<p class="badge">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
        {{ address | format_address }}
        <details>
          <summary class="link-small">{{ 'customer.addresses.edit' | t }}</summary>
          {%- form 'customer_address', address, class: 'form-stack' -%}
            {% render 'address-fields', form: form, id: address.id %}
            <button class="button" type="submit">{{ 'customer.addresses.save' | t }}</button>
          {%- endform -%}
        </details>
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}">
          <input type="hidden" name="_method" value="delete">
          <button class="link-small link-button" type="submit">{{ 'customer.addresses.delete' | t }}</button>
        </form>
      </div>
    {%- endfor -%}

    <details class="card">
      <summary class="button button--outline">{{ 'customer.addresses.add' | t }}</summary>
      {%- form 'customer_address', customer.new_address, class: 'form-stack' -%}
        {% render 'address-fields', form: form, id: 'new' %}
        <button class="button" type="submit">{{ 'customer.addresses.save' | t }}</button>
      {%- endform -%}
    </details>

    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "Customer addresses", "settings": [] }
{% endschema %}
