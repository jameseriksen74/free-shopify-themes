<div class="section">
  <div class="page-width page-width--form">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="ResetPassword">{{ 'customer.fields.password' | t }}</label>
      <input id="ResetPassword" class="field" type="password" name="customer[password]" autocomplete="new-password">
      <label for="ResetConfirm">{{ 'customer.fields.password_confirm' | t }}</label>
      <input id="ResetConfirm" class="field" type="password" name="customer[password_confirmation]" autocomplete="new-password">
      <button class="button" type="submit">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
