<div class="section section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header"><h2 class="h2">{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <ul class="collection-grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <li {{ block.shopify_attributes }}>
          {% render 'collection-card', collection: c %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by mood" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Collection list", "blocks": [ { "type": "collection" }, { "type": "collection" }, { "type": "collection" } ] }]
}
{% endschema %}
