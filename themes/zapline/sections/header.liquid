<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
  <div class="page-width site-header__inner">
    <details class="mobile-nav" data-mobile-nav>
      <summary class="icon-button mobile-nav__toggle" aria-label="{{ 'sections.header.menu' | t }}">
        {% render 'icon', icon: 'menu' %}
      </summary>
      <div class="mobile-nav__panel">
        <nav aria-label="{{ 'sections.header.menu' | t }}">
          <ul class="mobile-nav__list" role="list">
            {%- for link in section.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}" class="mobile-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- if link.links != blank -%}
                  <ul class="mobile-nav__sublist" role="list">
                    {%- for child in link.links -%}
                      <li><a href="{{ child.url }}" class="mobile-nav__sublink">{{ child.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if shop.customer_accounts_enabled -%}
              <li><a href="{{ routes.account_url }}" class="mobile-nav__link">{{ 'customer.account.title' | t }}</a></li>
            {%- endif -%}
          </ul>
        </nav>
      </div>
    </details>

    <div class="site-header__brand">
      {%- if request.page_type == 'index' -%}<h1 class="site-header__heading">{%- endif -%}
      <a href="{{ routes.root_url }}" class="site-header__logo">
        {%- if section.settings.logo != blank -%}
          {%- capture logo_style -%}max-width: {{ section.settings.logo_width }}px{%- endcapture -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag:
            alt: shop.name,
            widths: '150, 300, 450, 600',
            sizes: '(min-width: 750px) 220px, 160px',
            style: logo_style,
            class: 'site-header__logo-image'
          }}
        {%- else -%}
          <span class="site-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}</h1>{%- endif -%}
    </div>

    <nav class="site-nav" aria-label="{{ 'sections.header.menu' | t }}">
      <ul class="site-nav__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="site-nav__item">
            {%- if link.links != blank -%}
              <details class="site-nav__dropdown" data-dropdown>
                <summary class="site-nav__link">{{ link.title | escape }} {% render 'icon', icon: 'caret' %}</summary>
                <ul class="site-nav__submenu" role="list">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}" class="site-nav__sublink"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="site-nav__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
      <details class="header-search" data-search>
        <summary class="icon-button" aria-label="{{ 'general.search.search' | t }}">{% render 'icon', icon: 'search' %}</summary>
        <div class="header-search__panel">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
            <label class="visually-hidden" for="HeaderSearch">{{ 'general.search.search' | t }}</label>
            <input id="HeaderSearch" class="field" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" data-predictive-input>
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
          </form>
          <div class="predictive-results" data-predictive-results aria-live="polite"></div>
        </div>
      </details>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button header-account" aria-label="{{ 'customer.account.title' | t }}">{% render 'icon', icon: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button header-cart" aria-label="{{ 'sections.header.cart' | t }}">
        {% render 'icon', icon: 'bag' %}
        <span class="header-cart__count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
