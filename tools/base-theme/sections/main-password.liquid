<div class="password">
  <div class="password__card card">
    <p class="eyebrow">{{ 'general.password.opening_soon' | t }}</p>
    <h1 class="h1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="inline-field">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.label' | t }}</label>
          <input id="PasswordNewsletter" class="field" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required>
          <button class="button" type="submit">{{ 'newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <details class="password__login">
      <summary class="link-small">{{ 'general.password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'inline-field' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label class="visually-hidden" for="Password">{{ 'general.password.label' | t }}</label>
        <input id="Password" class="field" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password.label' | t }}">
        <button class="button" type="submit">{{ 'general.password.submit' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</div>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
