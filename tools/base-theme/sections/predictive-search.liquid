{%- if predictive_search.performed -%}
  <div class="predictive">
    {%- if predictive_search.resources.products.size > 0 -%}
      <ul class="predictive__list" role="list">
        {%- for product in predictive_search.resources.products -%}
          <li>
            <a href="{{ product.url }}" class="predictive__item">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', class: 'predictive__image', sizes: '60px' }}
              {%- endif -%}
              <span>{{ product.title | escape }}</span>
              <span class="muted">{{ product.price | money }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="muted">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  </div>
{%- endif -%}
