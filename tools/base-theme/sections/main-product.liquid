{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="section product section-{{ section.id }}" data-product data-section="{{ section.id }}">
  <div class="page-width product__grid">
    <div class="product__media">
      {%- assign featured = current_variant.featured_media | default: product.featured_media -%}
      <div class="product__main-image media-frame" data-main-media>
        {%- if featured != blank -%}
          {{ featured | image_url: width: 1600 | image_tag:
            widths: '500, 800, 1100, 1400, 1600',
            sizes: '(min-width: 990px) 55vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'cover',
            data-main-image: ''
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="product__thumbs" role="list">
          {%- for media in product.media -%}
            {%- if media.media_type == 'image' -%}
              <li>
                <button type="button" class="product__thumb media-frame" data-thumb data-src="{{ media | image_url: width: 1600 }}" data-media-id="{{ media.id }}" aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}">
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', class: 'cover', sizes: '100px' }}
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'vendor' -%}
            <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor | escape }}</p>
          {%- when 'title' -%}
            <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
          {%- when 'price' -%}
            <div class="product__price" data-price {{ block.shopify_attributes }}>
              {% render 'price', product: product, variant: current_variant %}
            </div>
            {%- form 'product', product, class: 'product__installments' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
              {{ form | payment_terms }}
            {%- endform -%}
          {%- when 'description' -%}
            <div class="product__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'ProductForm-{{ section.id }}', class: 'product-form', data-product-form: '' -%}
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <fieldset class="option">
                      <legend class="option__label">{{ option.name | escape }}</legend>
                      <div class="option__values">
                        {%- for value in option.values -%}
                          <input type="radio" class="visually-hidden" id="Opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}" data-option-index="{{ forloop.parentloop.index0 }}"{% if option.selected_value == value %} checked{% endif %}>
                          <label class="pill" for="Opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value | escape }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                <select name="id" class="visually-hidden" data-variant-select aria-label="{{ 'products.product.variant' | t }}">
                  {%- for variant in product.variants -%}
                    <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title | escape }}</option>
                  {%- endfor -%}
                </select>
                <script type="application/json" data-variants>{{ product.variants | json }}</script>

                <div class="quantity-row">
                  <label class="visually-hidden" for="Qty-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                  <input id="Qty-{{ section.id }}" class="field field--qty" type="number" name="quantity" value="1" min="1">
                  <button type="submit" name="add" class="button button--large button--full" data-add-button{% unless current_variant.available %} disabled{% endunless %}>
                    {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
                <p class="form-message form-message--error" data-form-error hidden></p>
              {%- endform -%}
              <div class="pickup" data-pickup>
                {%- assign pick_up_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
                {%- if pick_up_availabilities.size > 0 -%}
                  <p class="pickup__text">{{ 'products.product.pickup_available' | t: location: pick_up_availabilities.first.location.name }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__title">{{ block.settings.heading | escape }} {% render 'icon', icon: 'plus' %}</summary>
              <div class="accordion__content rte">{{ block.settings.content }}{{ block.settings.page.content }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.show_recommendations -%}
  <div class="section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id=related-products&product_id={{ product.id }}&limit=4"></div>
{%- endif -%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_recommendations", "label": "Show related products", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
    ] },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" } ] },
    { "type": "collapsible", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
      { "type": "richtext", "id": "content", "label": "Content" },
      { "type": "page", "id": "page", "label": "Content from page" }
    ] }
  ]
}
{% endschema %}
