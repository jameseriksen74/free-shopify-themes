<div class="section">
  <div class="page-width">
    <div class="section-header">
      <h1 class="h1">{{ 'customer.account.title' | t }}</h1>
      <a class="link-arrow" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </div>
    <div class="account">
      <div>
        <h2 class="h3">{{ 'customer.account.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead><tr><th>{{ 'customer.order.number' | t }}</th><th>{{ 'customer.order.date' | t }}</th><th>{{ 'customer.order.status' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p class="muted">{{ 'customer.account.no_orders' | t }}</p>
          {%- endif -%}
          {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
        {%- endpaginate -%}
      </div>
      <div class="card">
        <h2 class="h3">{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}</p>
        {{ customer.default_address | format_address }}
        <a class="link-arrow" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{ "name": "Customer account", "settings": [] }
{% endschema %}
